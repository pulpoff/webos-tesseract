new file mode 100644
index 0000000..a879ebb
--- /dev/null
+++ b/config/webos.cfg
@@ -0,0 +1,54 @@
+// LG webOS TVs: the remote and game controllers, with the Quake III port's controls, and the
+// settings for the TV. main.cpp runs this on the first start and when it changes;
+// src/engine/webos.cpp turns the controllers' buttons and sticks into these keys.
+
+// The remote: the arrows walk and turn, OK shoots, and Back (Escape) opens the menu.
+bind "UP"     [forward]
+bind "DOWN"   [backward]
+bind "LEFT"   [turnleft]
+bind "RIGHT"  [turnright]
+bind "RETURN" [shoot]
+
+// Game controllers: the left stick (or the D-pad) walks and the right stick looks.
+bind "PAD_LS_UP"    [forward]
+bind "PAD_LS_DOWN"  [backward]
+bind "PAD_LS_LEFT"  [left]
+bind "PAD_LS_RIGHT" [right]
+bind "PAD_UP"       [forward]
+bind "PAD_DOWN"     [backward]
+bind "PAD_LEFT"     [left]
+bind "PAD_RIGHT"    [right]
+// R2/RT shoots and L2/LT zooms
+bind "PAD_R2" [shoot]
+bind "PAD_L2" [dozoom]
+// L1/LB and Cross/A jump, Circle/B crouches, Square/X hits
+bind "PAD_L1" [jump]
+bind "PAD_A"  [jump]
+bind "PAD_B"  [crouch]
+bind "PAD_X"  [melee]
+// R1/RB and Triangle/Y change weapons, to the next and the previous
+bind "PAD_R1" [nextweapon 1]
+bind "PAD_Y"  [nextweapon -1]
+// Share/Back holds the scores up; Options/Start is the menu (Escape)
+bind "PAD_BACK" [holdui scoreboard]
+
+// spectating
+specbind "PAD_R2" [nextfollow]
+specbind "PAD_L2" [nextfollow -1]
+specbind "PAD_A"  [nextspecmode]
+specbind "PAD_L1" [nextspecmode]
+specbind "PAD_B"  [floatspeed 25;onrelease [floatspeed 100]]
+
+// editing: the controllers walk, look and jump as in the game
+editbind "PAD_R2" [editdrag]
+editbind "PAD_L2" [editextend]
+
+// The TV's GPU: volumetric light (sunbeams) halves the frame rate in sunlit views, and drawing
+// 75% of the screen's width and height (1440x810 at 1080p) gains half again in busy views.
+volumetric 0
+gscale 75
+// FXAA smooths edges for next to nothing; SMAA and temporal AA (in the options) cost 15-20%.
+fxaa 1
+
+// the version of this file: main.cpp runs it again when WEBOS_CONFIG is newer
+webosconfig 4
