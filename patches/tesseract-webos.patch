+#ifdef WEBOS_GLES
+// The program cache: the TV's driver takes up to a third of a second to compile one of the
+// shaders, and the deferred lighting alone has dozens of variants, which stalled the game for
+// half a minute. The programs it links are kept as OpenGL ES program binaries in
+// home/cache/shaders/, named by a hash of their sources, the driver and this build, and loaded
+// from there the next time.
+PFNGLGETPROGRAMBINARYPROC glGetProgramBinary_ = NULL;
+PFNGLPROGRAMBINARYPROC glProgramBinary_ = NULL;
+PFNGLPROGRAMPARAMETERIPROC glProgramParameteri_ = NULL;
+int webosshaderloads = 0, webosshadercompiles = 0;
+uint webosshadermillis = 0;
+
+// the shader whose vertex or fragment source a shader uses: its own, or the one it reuses
+static Shader *shadersource(Shader *s, bool vs)
+{
+    while(s && !(vs ? s->vsstr : s->psstr)) s = vs ? s->reusevs : s->reuseps;
+    return s;
+}
+
+static unsigned long long hashbytes(unsigned long long h, const void *data, size_t len)
+{
+    const uchar *p = (const uchar *)data;
+    loopi(len) { h ^= p[i]; h *= 1099511628211ULL; }
+    return h;
+}
+
+static unsigned long long hashstring(unsigned long long h, const char *s)
+{
+    return hashbytes(h, s ? s : "", s ? strlen(s) + 1 : 1);
+}
+
+static bool programcachepath(Shader &s, string &path)
+{
+    static int usecache = -1;
+    if(usecache < 0)
+    {
+        const char *env = getenv("WEBOS_SHADERCACHE");
+        usecache = glGetProgramBinary_ && glProgramBinary_ && !(env && env[0] == '0') ? 1 : 0;
+    }
+    Shader *vs = shadersource(&s, true), *ps = shadersource(&s, false);
+    if(!usecache || !vs || !ps) return false;
+    unsigned long long h = 14695981039346656037ULL;
+    h = hashstring(h, __DATE__ " " __TIME__);
+    h = hashstring(h, (const char *)glGetString(GL_RENDERER));
+    h = hashstring(h, (const char *)glGetString(GL_VERSION));
+    h = hashstring(h, vs->vsstr);
+    h = hashstring(h, ps->psstr);
+    loopv(s.attriblocs)
+    {
+        h = hashstring(h, s.attriblocs[i].name);
+        h = hashbytes(h, &s.attriblocs[i].loc, sizeof(s.attriblocs[i].loc));
+    }
+    formatstring(path, "cache/shaders/%016llx.bin", h);
+    return true;
+}
+
+static bool loadprogrambinary(Shader &s, const char *path)
+{
+    stream *f = openrawfile(path, "rb");
+    if(!f) return false;
+    int len = int(f->size()) - int(sizeof(GLenum));
+    GLenum format = 0;
+    bool ok = false;
+    if(len > 0 && f->read(&format, sizeof(format)) == sizeof(format))
+    {
+        uchar *buf = new uchar[len];
+        if(f->read(buf, len) == size_t(len))
+        {
+            s.program = glCreateProgram_();
+            glProgramBinary_(s.program, format, buf, len);
+            GLint success = 0;
+            glGetProgramiv_(s.program, GL_LINK_STATUS, &success);
+            if(success) ok = true;
+            else { glDeleteProgram_(s.program); s.program = 0; }
+        }
+        delete[] buf;
+    }
+    delete f;
+    return ok;
+}
+
+static void saveprogrambinary(Shader &s, const char *path)
+{
+    GLint len = 0;
+    glGetProgramiv_(s.program, GL_PROGRAM_BINARY_LENGTH, &len);
+    if(len <= 0) return;
+    uchar *buf = new uchar[len];
+    GLsizei got = 0;
+    GLenum format = 0;
+    glGetProgramBinary_(s.program, len, &got, &format, buf);
+    stream *f = got > 0 ? openrawfile(path, "wb") : NULL;
+    if(f)
+    {
+        f->write(&format, sizeof(format));
+        f->write(buf, got);
+        delete f;
+    }
+    delete[] buf;
+}
+
+bool Shader::compile()
+{
+    static const bool debug = getenv("WEBOS_DEBUG") != NULL;
+    uint start = SDL_GetTicks();
+    string path;
+    bool cache = programcachepath(*this, path), ok;
+    if(cache && loadprogrambinary(*this, path))
+    {
+        setupglslprogram(*this);
+        webosshaderloads++;
+        ok = true;
+    }
+    else
+    {
+        // a shader this one reuses may have come from the cache, without the object to reuse
+        Shader *vs = shadersource(this, true), *ps = shadersource(this, false);
+        if(vs && vs != this && !vs->vsobj && !vs->invalid())
+            compileglslshader(*vs, GL_VERTEX_SHADER, vs->vsobj, vs->vsstr, vs->name, dbgshader || !vs->variantshader);
+        if(ps && ps != this && !ps->psobj && !ps->invalid())
+            compileglslshader(*ps, GL_FRAGMENT_SHADER, ps->psobj, ps->psstr, ps->name, dbgshader || !ps->variantshader);
+        ok = compileprograms();
+        if(ok && cache) saveprogrambinary(*this, path);
+        webosshadercompiles++;
+    }
+    uint took = SDL_GetTicks() - start;
+    webosshadermillis += took;
+    if(debug && took >= 100) logoutf("shader %s: %u ms", name, took);
+    return ok;
+}
+
+bool Shader::compileprograms()
+{
+    Shader *vs = shadersource(reusevs, true), *ps = shadersource(reuseps, false);
+    if(!vsstr) vsobj = !reusevs || reusevs->invalid() || !vs ? 0 : vs->vsobj;
+    else compileglslshader(*this, GL_VERTEX_SHADER,   vsobj, vsstr, name, dbgshader || !variantshader);
+    if(!psstr) psobj = !reuseps || reuseps->invalid() || !ps ? 0 : ps->psobj;
+    else compileglslshader(*this, GL_FRAGMENT_SHADER, psobj, psstr, name, dbgshader || !variantshader);
+#else
 bool Shader::compile()
 {
     if(!vsstr) vsobj = !reusevs || reusevs->invalid() ? 0 : reusevs->vsobj;
     else compileglslshader(*this, GL_VERTEX_SHADER,   vsobj, vsstr, name, dbgshader || !variantshader);
     if(!psstr) psobj = !reuseps || reuseps->invalid() ? 0 : reuseps->psobj;
     else compileglslshader(*this, GL_FRAGMENT_SHADER, psobj, psstr, name, dbgshader || !variantshader);
+#endif
     linkglslprogram(*this, !variantshader);
     return program!=0;
 }
