diff --git a/src/engine/webos.cpp b/src/engine/webos.cpp
new file mode 100644
index 0000000..e4235d8
--- /dev/null
+++ b/src/engine/webos.cpp
@@ -0,0 +1,312 @@
+// LG webOS TVs: the remote, game controllers and the Home button, with the controls of the
+// Quake III port (config/webos.cfg binds them):
+// - the remote's arrows walk and turn, OK shoots and Back is Escape (the menu);
+// - a game controller's buttons are keys named PAD_* (config/keymap.cfg), its left stick presses
+//   PAD_LS_* keys, which walk, and its right stick looks around;
+// - while a menu has the cursor (and no text is being typed), the remote's arrows and a
+//   controller's D-pad jump it to the next button that way (UI::navigate), OK and Cross (A) click,
+//   Circle (B) goes back, and the sticks move it freely; Options (Start) is Escape everywhere;
+// - Home pauses: the game stops drawing, its sound stops, a local game's time stands still, and the
+//   settings are saved.
+#include "engine.h"
+
+#ifdef WEBOS_GLES
+#include "SDL_mixer.h"
+
+extern int zoom, zoomfov;
+
+VARP(padyawspeed, 10, 200, 1000);    // the right stick, pushed all the way: degrees a second
+VARP(padpitchspeed, 10, 140, 1000);
+VARP(padinvert, 0, 0, 1);            // pushing the right stick up looks down
+VARP(padcursorspeed, 10, 100, 1000); // the cursor, pushed all the way: hundredths of the screen width a second
+VARP(remoteturnspeed, 10, 140, 1000); // the remote's Left and Right: degrees a second
+VARP(webosconfig, 0, 0, 1000);         // the version of config/webos.cfg in use (main.cpp)
+
+enum
+{
+    PAD_KEY = -100,              // PAD_KEY - SDL_CONTROLLER_BUTTON_*: PAD_A is -100
+    PAD_L2 = -120, PAD_R2 = -121,
+    PAD_LS_UP = -130, PAD_LS_DOWN = -131, PAD_LS_LEFT = -132, PAD_LS_RIGHT = -133
+};
+
+// slots for the keys the controllers hold: the buttons, the triggers and the left stick's four ways
+enum { SLOT_L2 = SDL_CONTROLLER_BUTTON_MAX, SLOT_R2, SLOT_LS, NUMSLOTS = SLOT_LS + 4 };
+
+static vector<SDL_GameController *> pads;
+static int held[NUMSLOTS];      // the key each slot pressed, so its release goes to the same key
+static bool turnleft = false, turnright = false;
+static bool wasminimized = false;
+static float cursorrest[2] = { 0, 0 };
+static int dpadheld = -1, dpadnext = 0; // the D-pad's way held in a menu, and when it repeats
+static bool okclick = false;            // the remote's OK pressed as a click
+
+extern int textinputmask;
+
+// the menus take the arrows: no text being typed into a field or the console
+static bool menukeys()
+{
+    return UI::hascursor() && !textinputmask;
+}
+
+static void dpadnavigate(int button)
+{
+    switch(button)
+    {
+        case SDL_CONTROLLER_BUTTON_DPAD_UP: UI::navigate(0, -1); break;
+        case SDL_CONTROLLER_BUTTON_DPAD_DOWN: UI::navigate(0, 1); break;
+        case SDL_CONTROLLER_BUTTON_DPAD_LEFT: UI::navigate(-1, 0); break;
+        case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: UI::navigate(1, 0); break;
+    }
+}
+
+ICOMMAND(turnleft, "D", (int *down), turnleft = *down != 0);
+ICOMMAND(turnright, "D", (int *down), turnright = *down != 0);
+
+static void padkey(int slot, int code, bool down)
+{
+    if(down)
+    {
+        if(held[slot] || !code) return;
+        held[slot] = code;
+        processkey(code, true);
+    }
+    else if(held[slot])
+    {
+        code = held[slot];
+        held[slot] = 0;
+        processkey(code, false);
+    }
+}
+
+static void releasepadkeys()
+{
+    loopi(NUMSLOTS) padkey(i, 0, false);
+}
+
+// in a menu Cross clicks and Circle goes back, and the D-pad moves between buttons (webosevent)
+static int buttonkey(int button)
+{
+    if(button == SDL_CONTROLLER_BUTTON_START) return SDLK_ESCAPE;
+    if(UI::hascursor()) switch(button)
+    {
+        case SDL_CONTROLLER_BUTTON_A: return -1;
+        case SDL_CONTROLLER_BUTTON_B: return SDLK_ESCAPE;
+        case SDL_CONTROLLER_BUTTON_DPAD_UP:
+        case SDL_CONTROLLER_BUTTON_DPAD_DOWN:
+        case SDL_CONTROLLER_BUTTON_DPAD_LEFT:
+        case SDL_CONTROLLER_BUTTON_DPAD_RIGHT:
+            return 0;
+    }
+    return PAD_KEY - button;
+}
+
+static void setminimized(bool on)
+{
+    if(minimized == on) return;
+    minimized = on;
+    logoutf(on ? "webOS: in the background, paused" : "webOS: back in the foreground");
+    if(on)
+    {
+        releasepadkeys();
+        turnleft = turnright = false;
+        // the TV may close the app from here without asking it to quit, which is when the
+        // settings would be saved
+        writecfg();
+    }
+}
+
+// the events Tesseract doesn't know: true when handled
+bool webosevent(const SDL_Event &e)
+{
+    switch(e.type)
+    {
+        case SDL_CONTROLLERDEVICEADDED:
+            if(SDL_IsGameController(e.cdevice.which))
+            {
+                SDL_GameController *pad = SDL_GameControllerOpen(e.cdevice.which);
+                if(pad)
+                {
+                    pads.add(pad);
+                    conoutf("game controller: %s", SDL_GameControllerName(pad));
+                }
+            }
+            return true;
+
+        case SDL_CONTROLLERDEVICEREMOVED:
+            loopv(pads) if(SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(pads[i])) == e.cdevice.which)
+            {
+                SDL_GameControllerClose(pads[i]);
+                pads.remove(i);
+                releasepadkeys();
+                break;
+            }
+            return true;
+
+        case SDL_CONTROLLERBUTTONDOWN:
+        case SDL_CONTROLLERBUTTONUP:
+            if(e.cbutton.button >= SDL_CONTROLLER_BUTTON_DPAD_UP && e.cbutton.button <= SDL_CONTROLLER_BUTTON_DPAD_RIGHT)
+            {
+                if(e.type == SDL_CONTROLLERBUTTONUP && dpadheld == e.cbutton.button) dpadheld = -1;
+                else if(e.type == SDL_CONTROLLERBUTTONDOWN && menukeys())
+                {
+                    dpadnavigate(e.cbutton.button);
+                    dpadheld = e.cbutton.button;
+                    dpadnext = SDL_GetTicks() + 400;
+                    return true;
+                }
+            }
+            if(e.cbutton.button < SDL_CONTROLLER_BUTTON_MAX)
+                padkey(e.cbutton.button, buttonkey(e.cbutton.button), e.type == SDL_CONTROLLERBUTTONDOWN);
+            return true;
+
+        case SDL_CONTROLLERAXISMOTION:
+            if(e.caxis.axis == SDL_CONTROLLER_AXIS_TRIGGERLEFT || e.caxis.axis == SDL_CONTROLLER_AXIS_TRIGGERRIGHT)
+            {
+                bool left = e.caxis.axis == SDL_CONTROLLER_AXIS_TRIGGERLEFT;
+                int slot = left ? SLOT_L2 : SLOT_R2;
+                if(e.caxis.value > 16000) padkey(slot, left ? PAD_L2 : PAD_R2, true);
+                else if(e.caxis.value < 8000) padkey(slot, 0, false);
+            }
+            return true;
+
+        case SDL_CONTROLLERDEVICEREMAPPED:
+        case SDL_JOYAXISMOTION: case SDL_JOYBALLMOTION: case SDL_JOYHATMOTION:
+        case SDL_JOYBUTTONDOWN: case SDL_JOYBUTTONUP: case SDL_JOYDEVICEADDED: case SDL_JOYDEVICEREMOVED:
+            return true;
+
+        case SDL_KEYDOWN:
+        case SDL_KEYUP:
+            // the remote's Back button
+            if(e.key.keysym.scancode == SDL_SCANCODE_WEBOS_BACK)
+            {
+                if(!e.key.repeat) processkey(SDLK_ESCAPE, e.type == SDL_KEYDOWN);
+                return true;
+            }
+            // OK (when the pointer isn't showing) clicks in a menu
+            if(e.key.keysym.sym == SDLK_RETURN || e.key.keysym.sym == SDLK_KP_ENTER)
+            {
+                if(e.type == SDL_KEYDOWN && !e.key.repeat && !okclick && menukeys())
+                {
+                    okclick = true;
+                    processkey(-1, true);
+                    return true;
+                }
+                if(e.type == SDL_KEYUP && okclick)
+                {
+                    okclick = false;
+                    processkey(-1, false);
+                    return true;
+                }
+                return false;
+            }
+            // the arrows move between a menu's buttons, repeating while held; their releases go on
+            // to the game, so a key held when a menu opened lets go
+            if(e.type == SDL_KEYDOWN && menukeys()) switch(e.key.keysym.sym)
+            {
+                case SDLK_UP: UI::navigate(0, -1); return true;
+                case SDLK_DOWN: UI::navigate(0, 1); return true;
+                case SDLK_LEFT: UI::navigate(-1, 0); return true;
+                case SDLK_RIGHT: UI::navigate(1, 0); return true;
+            }
+            return false;
+
+        case SDL_WINDOWEVENT:
+            switch(e.window.event)
+            {
+                case SDL_WINDOWEVENT_FOCUS_LOST:
+                case SDL_WINDOWEVENT_HIDDEN:
+                case SDL_WINDOWEVENT_MINIMIZED:
+                    setminimized(true);
+                    break;
+                case SDL_WINDOWEVENT_FOCUS_GAINED:
+                case SDL_WINDOWEVENT_SHOWN:
+                case SDL_WINDOWEVENT_RESTORED:
+                    setminimized(false);
+                    break;
+            }
+            return false;
+    }
+    return false;
+}
+
+static float padaxis(SDL_GameControllerAxis axis)
+{
+    int sum = 0;
+    loopv(pads) sum += SDL_GameControllerGetAxis(pads[i], axis);
+    return clamp(sum/32767.0f, -1.0f, 1.0f);
+}
+
+// past a dead zone, and gentler near the middle
+static float stickcurve(float v)
+{
+    float a = fabs(v);
+    if(a < 0.15f) return 0;
+    a = (a - 0.15f)/0.85f;
+    return v < 0 ? -a*a : a*a;
+}
+
+// each frame, with the milliseconds since the last
+void webosupdate(int millis)
+{
+    if(minimized != wasminimized)
+    {
+        wasminimized = minimized;
+        if(minimized) { Mix_Pause(-1); Mix_PauseMusic(); }
+        else { Mix_Resume(-1); Mix_ResumeMusic(); }
+    }
+    if(minimized || millis <= 0) return;
+    float secs = min(millis, 100)/1000.0f;
+
+    if(UI::hascursor())
+    {
+        // the menus: a held D-pad goes on to the next button, and the sticks move the cursor
+        loopi(4) padkey(SLOT_LS + i, 0, false);
+        turnleft = turnright = false;
+        if(pads.empty()) return;
+        if(dpadheld >= 0 && int(SDL_GetTicks() - dpadnext) >= 0)
+        {
+            if(menukeys()) dpadnavigate(dpadheld);
+            dpadnext += 150;
+        }
+        float dx = stickcurve(padaxis(SDL_CONTROLLER_AXIS_LEFTX)) + stickcurve(padaxis(SDL_CONTROLLER_AXIS_RIGHTX)),
+              dy = stickcurve(padaxis(SDL_CONTROLLER_AXIS_LEFTY)) + stickcurve(padaxis(SDL_CONTROLLER_AXIS_RIGHTY));
+        float speed = hudw*padcursorspeed/100.0f*secs;
+        cursorrest[0] += clamp(dx, -1.0f, 1.0f)*speed;
+        cursorrest[1] += clamp(dy, -1.0f, 1.0f)*speed;
+        int mx = int(cursorrest[0]), my = int(cursorrest[1]);
+        cursorrest[0] -= mx;
+        cursorrest[1] -= my;
+        if(mx || my) UI::movecursor(mx, my);
+        return;
+    }
+    cursorrest[0] = cursorrest[1] = 0;
+
+    // the game: the left stick walks, by keys
+    if(!pads.empty())
+    {
+        float x = padaxis(SDL_CONTROLLER_AXIS_LEFTX), y = padaxis(SDL_CONTROLLER_AXIS_LEFTY);
+        const float on = 0.5f, off = 0.35f;
+        const struct { float v; int code; } ways[4] = { { -y, PAD_LS_UP }, { y, PAD_LS_DOWN }, { -x, PAD_LS_LEFT }, { x, PAD_LS_RIGHT } };
+        loopi(4)
+        {
+            if(ways[i].v > on) padkey(SLOT_LS + i, ways[i].code, true);
+            else if(ways[i].v < off) padkey(SLOT_LS + i, 0, false);
+        }
+    }
+
+    // the right stick and the remote's Left and Right turn
+    if(!game::allowmouselook()) return;
+    float yaw = 0, pitch = 0;
+    if(!pads.empty())
+    {
+        yaw = stickcurve(padaxis(SDL_CONTROLLER_AXIS_RIGHTX))*padyawspeed;
+        pitch = -stickcurve(padaxis(SDL_CONTROLLER_AXIS_RIGHTY))*padpitchspeed*(padinvert ? -1 : 1);
+    }
+    if(turnleft) yaw -= remoteturnspeed;
+    if(turnright) yaw += remoteturnspeed;
+    if(!yaw && !pitch) return;
+    float scale = secs;
+    if(zoom) scale *= float(zoomfov)/fov;
+    modifyorient(yaw*scale, pitch*scale);
+}
+#endif
