+    struct NavTarget { float x0, y0, x1, y1; }; // in pixels of the screen
+
+    static bool isnavtarget(Object *o)
+    {
+        return o->istype<Target>() || o->istype<HorizontalSlider>() || o->istype<VerticalSlider>() ||
+               o->istype<TextEditor>() || o->istype<Field>() || o->istype<KeyField>();
+    }
+
+    // o's children, o being at (ox, oy) in its window's space and visible within (x0, y0)-(x1, y1)
+    static bool findnavtargets(Window *win, Object *o, float ox, float oy, float x0, float y0, float x1, float y1, vector<NavTarget> &out)
+    {
+        float scrollx = 0, scrolly = 0;
+        if(o->istype<Scroller>()) { scrollx = ((Scroller *)o)->offsetx; scrolly = ((Scroller *)o)->offsety; }
+        if(o->istype<Scroller>() || o->istype<Clipper>())
+        {
+            x0 = max(x0, ox); y0 = max(y0, oy);
+            x1 = min(x1, ox + o->w); y1 = min(y1, oy + o->h);
+        }
+        bool found = false;
+        loopv(o->children)
+        {
+            Object *c = o->children[i];
+            float cx = ox + c->x - scrollx, cy = oy + c->y - scrolly;
+            if(c->w <= 0 || c->h <= 0 || cx >= x1 || cy >= y1 || cx + c->w <= x0 || cy + c->h <= y0) continue;
+            bool inner = findnavtargets(win, c, cx, cy, x0, y0, x1, y1, out);
+            if(!inner && isnavtarget(c))
+            {
+                // window space to the cursor's (Window::*children inverted), in pixels
+                NavTarget &t = out.add();
+                t.x0 = (max(cx, x0) + win->x - win->px)/win->pw*hudw;
+                t.y0 = (max(cy, y0) + win->y - win->py)/win->ph*hudh;
+                t.x1 = (min(cx + c->w, x1) + win->x - win->px)/win->pw*hudw;
+                t.y1 = (min(cy + c->h, y1) + win->y - win->py)/win->ph*hudh;
+                inner = true;
+            }
+            if(inner) found = true;
+        }
+        return found;
+    }
+
+    bool navigate(int dx, int dy)
+    {
+        if(!hascursor()) return false;
+        vector<NavTarget> targets;
+        loopv(world->children)
+        {
+            Window *w = (Window *)world->children[i];
+            if(!w->allowinput || w->state&STATE_HIDDEN || w->pw <= 0 || w->ph <= 0) continue;
+            findnavtargets(w, w, 0, 0, w->px - w->x, w->py - w->y, w->px + w->pw - w->x, w->py + w->ph - w->y, targets);
+        }
+        float px = cursorx*hudw, py = cursory*hudh;
+        int best = -1;
+        float bestscore = 1e30f;
+        loopv(targets)
+        {
+            const NavTarget &t = targets[i];
+            if(px >= t.x0 && px < t.x1 && py >= t.y0 && py < t.y1) continue; // the one under the cursor
+            // how far that way, and how far off to the side (none for one in line)
+            float along, across;
+            if(dx) { along = ((t.x0 + t.x1)/2 - px)*dx; across = py < t.y0 ? t.y0 - py : (py > t.y1 ? py - t.y1 : 0); }
+            else { along = ((t.y0 + t.y1)/2 - py)*dy; across = px < t.x0 ? t.x0 - px : (px > t.x1 ? px - t.x1 : 0); }
+            if(along <= 1) continue;
+            float score = along + 3*across;
+            if(score < bestscore) { bestscore = score; best = i; }
+        }
+        if(best >= 0)
+        {
+            const NavTarget &t = targets[best];
+            cursorx = clamp((t.x0 + t.x1)/2/hudw, 0.0f, 1.0f);
+            cursory = clamp((t.y0 + t.y1)/2/hudh, 0.0f, 1.0f);
+        }
+        return true;
+    }
