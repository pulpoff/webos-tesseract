+// a crash logs its signal and where it happened, as library+offset (addr2line -e build/tesseract)
+static void webosprintaddr(const char *what, void *addr)
+{
+    Dl_info info;
+    char line[512];
+    if(dladdr(addr, &info) && info.dli_fname)
+        snprintf(line, sizeof(line), "  %s %p %s+%#lx %s\n", what, addr, info.dli_fname, (unsigned long)((char *)addr - (char *)info.dli_fbase), info.dli_sname ? info.dli_sname : "");
+    else snprintf(line, sizeof(line), "  %s %p\n", what, addr);
+    if(write(2, line, strlen(line))) {}
+}
+
+static void weboscrash(int sig, siginfo_t *si, void *ctx)
+{
+    char line[128];
+    snprintf(line, sizeof(line), "crash: signal %d at address %p\n", sig, si ? si->si_addr : NULL);
+    if(write(2, line, strlen(line))) {}
+    ucontext_t *uc = (ucontext_t *)ctx;
+    if(uc)
+    {
+        webosprintaddr("pc", (void *)uc->uc_mcontext.arm_pc);
+        webosprintaddr("lr", (void *)uc->uc_mcontext.arm_lr);
+    }
+    void *frames[32];
+    int n = backtrace(frames, 32);
+    loopi(n) webosprintaddr("at", frames[i]);
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
+static void webosexit()
+{
+    const char *line = "exit:\n";
+    if(write(2, line, strlen(line))) {}
+    void *frames[32];
+    int n = backtrace(frames, 32);
+    loopi(n) webosprintaddr("at", frames[i]);
+}
+// LG webOS TVs: the app manager starts the game with its launch parameters (JSON) as the first
+// argument and drops what it prints. The game runs from its app folder, its settings go to the
+// folder's home/, its log to /tmp/tesseract.log, and the remote's Back button goes to the game.
+static void webosinit(int &argc, char **argv)
+{
+    // /tmp/tesseract.env: NAME=value a line, for testing
+    if(FILE *env = fopen("/tmp/tesseract.env", "r"))
+    {
+        char line[512];
+        while(fgets(line, sizeof(line), env))
+        {
+            line[strcspn(line, "\r\n")] = '\0';
+            char *eq = strchr(line, '=');
+            if(eq && eq != line) { *eq = '\0'; setenv(line, eq+1, 1); }
+        }
+        fclose(env);
+    }
+    char exe[1024];
+    ssize_t len = readlink("/proc/self/exe", exe, sizeof(exe)-1);
+    if(len > 0)
+    {
+        exe[len] = '\0';
+        char *slash = strrchr(exe, '/');
+        if(slash) { *slash = '\0'; if(chdir(exe)) {} }
+    }
+    if(argc > 1 && argv[1][0] == '{')
+    {
+        for(int i = 1; i < argc-1; i++) argv[i] = argv[i+1];
+        argc--;
+    }
+    if(freopen("/tmp/tesseract.log", "w", stdout))
+    {
+        setvbuf(stdout, NULL, _IOLBF, 0);
+        dup2(fileno(stdout), 2);
+    }
+    setenv("SDL_WEBOS_ACCESS_POLICY_KEYS_BACK", "true", 1);
+    // SDL's full mode for Sony controllers over Bluetooth, in which it sets the light bar (else a
+    // DualShock 4's keeps blinking) and can rumble
+    setenv("SDL_JOYSTICK_HIDAPI_PS4_RUMBLE", "1", 0);
+    setenv("SDL_JOYSTICK_HIDAPI_PS5_RUMBLE", "1", 0);
+    struct sigaction sa;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_sigaction = weboscrash;
+    sa.sa_flags = SA_SIGINFO;
+    const int sigs[] = { SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT };
+    loopi(sizeof(sigs)/sizeof(sigs[0])) sigaction(sigs[i], &sa, NULL);
+    if(getenv("WEBOS_DEBUG")) atexit(webosexit);
+}
